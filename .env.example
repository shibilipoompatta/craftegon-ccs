# ==============================================================================
# CraftEgon CCS - Safe Local Configuration Template (.env.example)
# ==============================================================================
# NOTICE:
# This file contains configuration keys and non-sensitive PLACEHOLDERS ONLY.
# NEVER commit real API keys, production database passwords, or payment secrets.
#
# To use locally:
# Copy this file to '.env.local' or '.env' and populate with local development stubs.
# Ensure '.env' and '.env.local' remain strictly excluded in .gitignore.
# ==============================================================================

# --- Runtime & Server Baseline ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
CORS_ORIGIN=http://localhost:8080

# --- Security & Anti-Abuse Controls ---
# Salt used for one-way anonymization of client IP addresses before rate limiting
IP_HASH_SALT=craftegon-local-dev-salt-baseline-change-in-prod
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_REQUESTS=5
MAX_PAYLOAD_SIZE_BYTES=32768
BOT_DETECTION_MIN_TIME_MS=2000
# Comma-separated list of trusted upstream reverse proxy IPs (e.g. 127.0.0.1, 10.0.0.1).
# If empty (default), X-Forwarded-For is completely IGNORED to prevent IP spoofing attacks.
TRUSTED_PROXIES=

# --- Statutory Retention & Data Minimization (DPDP Act 2023) ---
# Maximum days unconverted prospective enquiry records are retained before automated purge
LEAD_RETENTION_DAYS=180

# --- Candidate Provider 1: Managed PostgreSQL + Auth (Supabase Baseline) ---
# NOTE: Candidate only. Requires formal partner approval before provisioning.
# Database Host Region: AWS Mumbai (ap-south-1)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJh...[SAFE_CLIENT_ANON_KEY_PLACEHOLDER]
# CRITICAL: The service role key bypasses PostgreSQL RLS. NEVER expose in client bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJh...[SERVER_ONLY_PRIVILEGED_KEY_PLACEHOLDER]
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# --- Candidate Provider 2: Self-Managed Cloud (AWS RDS PostgreSQL) ---
AWS_REGION=ap-south-1
RDS_DATABASE_URL=postgresql://craftegon_app:[PASSWORD]@ccs-dev-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/craftegon_ccs
S3_VAULT_BUCKET=craftegon-client-vault-ap-south-1-dev

# --- Fallback Provider: Edge Serverless (Cloudflare Workers / D1 / R2) ---
CLOUDFLARE_ACCOUNT_ID=placeholder_cloudflare_account_id
CLOUDFLARE_D1_DATABASE_ID=placeholder_d1_database_uuid
CLOUDFLARE_R2_BUCKET_NAME=craftegon-vault-edge-local
CLOUDFLARE_TURNSTILE_SECRET_KEY=placeholder_turnstile_secret_key

# --- Candidate Payment Gateway (Razorpay Sandbox Only) ---
# NOTE: Candidate only. Zero live payment processing or commercial activation authorized.
# Test Key format: rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret_do_not_commit
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret_signature

# --- Telemetry & Logging ---
LOG_LEVEL=info
ENABLE_MASKED_AUDIT_LOG=true
