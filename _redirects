# --- Custom 301 Permanent Redirects (Legacy to New Structure) ---
# Example: /old-path  /new-path  301

# --- Clean URL Rewrites (Status 200 for internal mapping) ---
/portal        /portal/index.html      200
/knowledge     /knowledge/index.html   200
/conversion    /conversion/index.html  200
/portal/*      /portal/:splat          200
/verticals/*   /verticals/:splat       200
/services/*    /services/:splat        200
/knowledge/*   /knowledge/:splat       200
/conversion/*  /conversion/:splat      200
/legal/*       /legal/:splat           200

# --- Global Fallback for 404 Not Found Routing ---
/*             /404.html               404
