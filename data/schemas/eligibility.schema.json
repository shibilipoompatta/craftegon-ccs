{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccs.craftegon.com/schemas/eligibility.schema.json",
  "title": "CraftEgon CCS Eligibility and Prerequisites Schema",
  "description": "JSON Schema Draft 2020-12 defining entity applicability, statutory prerequisites, document checklists, and verification states.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "eligibility_id",
      "service_id",
      "applicable_entity_types",
      "prerequisites",
      "required_documents",
      "exceptions_and_limitations",
      "jurisdiction",
      "source_id",
      "verification_status"
    ],
    "additionalProperties": false,
    "properties": {
      "eligibility_id": {
        "type": "string",
        "pattern": "^ELG-V\\d{2}-SVC-\\d{3}$",
        "description": "Unique eligibility record identifier mapped to service ID."
      },
      "service_id": {
        "type": "string",
        "pattern": "^V\\d{2}-SVC-\\d{3}$",
        "description": "Approved active service identifier reference."
      },
      "applicable_entity_types": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "PVT_LTD",
            "PUBLIC_UNLISTED",
            "OPC",
            "LLP",
            "PARTNERSHIP",
            "PROPRIETORSHIP",
            "SECTION_8",
            "TRUST",
            "SOCIETY",
            "FOREIGN_COMPANY",
            "INDIVIDUAL"
          ]
        },
        "description": "Controlled enumeration of applicable entity types under Indian law."
      },
      "prerequisites": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "description": "Statutory prerequisites and qualifying criteria."
      },
      "required_documents": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" },
        "description": "Mandatory documentary submissions and proofs."
      },
      "exceptions_and_limitations": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Ineligibility conditions and statutory carve-outs."
      },
      "jurisdiction": {
        "type": "string",
        "description": "Statutory jurisdiction code (e.g. IN-CENTRAL)."
      },
      "source_id": {
        "type": ["string", "null"],
        "pattern": "^SRC-[A-Z0-9-]+$",
        "description": "Authoritative statute or notification reference."
      },
      "verification_status": {
        "type": "string",
        "enum": ["UNREVIEWED", "SOURCE_IDENTIFIED", "PENDING_PROFESSIONAL_REVIEW", "VERIFIED", "REJECTED"],
        "description": "Verification status of the eligibility criteria."
      },
      "last_verified_at": {
        "type": ["string", "null"],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date of latest verification check."
      },
      "primary_vertical_id": {
        "type": "string",
        "pattern": "^V\\d{2}$",
        "description": "Primary practice vertical identifier matching service registry."
      },
      "statutory_provision": {
        "type": "string",
        "description": "Exact section, rule, or gazetted notification establishing the legal prerequisite."
      },
      "operational_recommendations": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Operational best practices and secretarial recommendations distinct from statutory mandates."
      },
      "unresolved_questions": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Unresolved legal questions or procedural gaps requiring qualified professional review."
      },
      "checked_date": {
        "type": ["string", "null"],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Date on which the statutory source/rule was audited against official portals."
      },
      "notes": {
        "type": "string",
        "description": "Explanatory notes and legal evidence audit remarks."
      },
      "next_review_at": {
        "type": ["string", "null"],
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Scheduled periodic review date."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "verification_status": { "const": "VERIFIED" }
          }
        },
        "then": {
          "properties": {
            "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
            "last_verified_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          "required": ["source_id", "last_verified_at"]
        }
      }
    ]
  }
}
